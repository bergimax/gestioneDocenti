# Copy to .env.production at the repository root (git-ignored) and fill in.
# Compose reads it for interpolation and passes it to web and worker.
# Values must not be quoted and must not contain spaces.

# Required. Public host name only (no scheme, no path). Caddy gets a
# certificate for it; Django trusts https://DOMAIN for CSRF.
DOMAIN=

# Required. Django secret key. Generate: openssl rand -base64 48 | tr -d '\n='
SECRET_KEY=

# Required. Comma-separated host names Django answers to. Normally the same as DOMAIN.
ALLOWED_HOSTS=

# Optional, default false. Leave unset or false in production.
DEBUG=false

# Postgres user, database and password. DATABASE_URL is built by compose from these.
# POSTGRES_PASSWORD is required and must use only A-Z a-z 0-9 . _ ~ - (it goes in a URL).
# Generate: openssl rand -hex 24
POSTGRES_USER=gestione
POSTGRES_DB=gestione_docenti
POSTGRES_PASSWORD=

# Optional, default 60. Positive integer, seconds. Solver time limit per generation job.
SOLVER_TIMEOUT_SECONDS=60

# Optional, default 10. Positive integer, seconds, below SOLVER_TIMEOUT_SECONDS.
SOLVER_EXPLAIN_BUDGET_SECONDS=10

# Optional, default 120. Positive integer, seconds. A job RUNNING longer than SOLVER_TIMEOUT_SECONDS plus this margin is marked failed (worker killed).
# SOLVER_STALE_MARGIN_SECONDS=120

# Optional, default 5242880 (5 MiB). Positive integer, bytes. Largest file the setup wizard accepts.
SETUP_MAX_UPLOAD_BYTES=5242880

# Optional, default 72. Positive integer, hours. Validity of a magic availability link.
AVAILABILITY_LINK_TTL_HOURS=72

# Optional, default 10. Failed magic-link lookups per address within the window before HTTP 429.
LINK_LOOKUP_MAX_FAILURES=10

# Optional, default 300. Positive integer, seconds. Window for LINK_LOOKUP_MAX_FAILURES.
LINK_LOOKUP_WINDOW_SECONDS=300

# Optional, default 30. Failed calendar-feed token lookups per address within the window before HTTP 429.
FEED_LOOKUP_MAX_FAILURES=30

# Optional, default 300. Positive integer, seconds. Window for FEED_LOOKUP_MAX_FAILURES, also sent as Retry-After.
FEED_LOOKUP_WINDOW_SECONDS=300

# Optional, default empty. Anthropic API key. Empty turns the AI features off.
ANTHROPIC_API_KEY=

# Optional, default claude-haiku-4-5. Anthropic model used for the AI features.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional, default 60. Positive integer, seconds. Time limit for one Anthropic call.
ANTHROPIC_TIMEOUT_SECONDS=60

# Optional, default ./backups (under the repository, git-ignored). Directory where deploy/backup.sh writes its dumps.
BACKUP_DIR=./backups

# Optional, default 14. Positive integer. How many of the newest dumps are kept; older ones are deleted.
BACKUP_KEEP=14

# Optional, default 30. Positive integer, hours. A backup older than this is STALE for
# deploy/backup-status.sh (daily in cron.example) and on the admin overview page.
# docker-compose.yml mounts BACKUP_DIR read-only into web and sets BACKUP_MARKER_FILE itself.
# BACKUP_STALE_HOURS=30

# Optional, default empty. rclone destination of the weekly off-site copy, e.g. oracle:bucket/path.
# The bucket MUST be private: the dumps hold personal data of teachers. Empty turns the off-site copy off.
OFFSITE_RCLONE_REMOTE=

# Optional, default empty. Path of an rclone config file on the host. Alternatively define the
# credentials here as RCLONE_CONFIG_<REMOTE>_TYPE, RCLONE_CONFIG_<REMOTE>_ACCESS_KEY_ID, ... (see rclone docs).
OFFSITE_RCLONE_CONFIG=

# Optional, default 0. Non-negative integer. Caddy is the one proxy in front of
# Django and sets X-Forwarded-For to the client address; 1 makes Django use it
# (login throttle, link lookup limiter). Keep 1 with this stack.
TRUSTED_PROXY_COUNT=1

# Optional, default off. Non-negative integer, seconds. Blank or 0 sends no Strict-Transport-Security
# header. Raise it in steps 300, 86400, 2592000, 31536000, one step only after a day without trouble.
# No includeSubDomains and no preload, on purpose.
SECURE_HSTS_SECONDS=

# Memory limits per container (docker-compose.yml), tuned for the 1 GB VM: the four limits add up to 1 GB on purpose.
# A reservation must not exceed its limit, or Docker refuses to start.

# Postgres defaults plus a pg_dump; never the OOM victim.
# Optional, default 256m. Maximum memory of postgres, an integer followed by b, k, m or g.
# POSTGRES_MEM_LIMIT=256m

# Postgres defaults plus a pg_dump; never the OOM victim.
# Optional, default 128m. Soft reservation memory of postgres, an integer followed by b, k, m or g.
# POSTGRES_MEM_RESERVATION=128m

# 2 gunicorn workers plus PDF export; first guess, see #153.
# Optional, default 256m. Maximum memory of web, an integer followed by b, k, m or g.
# WEB_MEM_LIMIT=256m

# 2 gunicorn workers plus PDF export; first guess, see #153.
# Optional, default 160m. Soft reservation memory of web, an integer followed by b, k, m or g.
# WEB_MEM_RESERVATION=160m

# The worker cannot use swap (memswap_limit equals this limit): a runaway solve is killed at once, never the site.
# A solve that needs more fails the same way; raise this one on a bigger VM.
# Optional, default 448m. Maximum memory of worker, an integer followed by b, k, m or g.
# WORKER_MEM_LIMIT=448m

# solver peak about 350 MB plus headroom.
# Optional, default 256m. Soft reservation memory of worker, an integer followed by b, k, m or g.
# WORKER_MEM_RESERVATION=256m

# Go proxy, tens of MB.
# Optional, default 64m. Maximum memory of caddy, an integer followed by b, k, m or g.
# CADDY_MEM_LIMIT=64m

# Go proxy, tens of MB.
# Optional, default 32m. Soft reservation memory of caddy, an integer followed by b, k, m or g.
# CADDY_MEM_RESERVATION=32m
