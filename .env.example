# Copy to .env (git-ignored) and run: uv run --env-file .env manage.py runserver

# Required. Django secret key. No default. Generate a long random string.
SECRET_KEY=change-me

# Optional, default false. Accepts true, false, 1, 0 (case-insensitive).
DEBUG=false

# Required when DEBUG is false, optional otherwise. Comma-separated host names.
ALLOWED_HOSTS=localhost,127.0.0.1

# Required. PostgreSQL URL; URL-encode special characters in the password (@ is %40).
DATABASE_URL=postgres://user:password@localhost:5432/gestione_docenti

# Optional, default 60. Positive integer, seconds.
SOLVER_TIMEOUT_SECONDS=60

# Optional, default 5242880 (5 MiB). Positive integer, bytes. Largest file the setup wizard accepts.
SETUP_MAX_UPLOAD_BYTES=5242880
