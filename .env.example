# Copy to .env (git-ignored) and run: uv run --env-file .env manage.py runserver

# Required. Django secret key. No default. Generate a long random string.
SECRET_KEY=change-me

# Optional, default false. Accepts true, false, 1, 0 (case-insensitive).
DEBUG=false

# Required when DEBUG is false, optional otherwise. Comma-separated host names.
ALLOWED_HOSTS=localhost,127.0.0.1

# Required. PostgreSQL URL; URL-encode special characters in the password (@ is %40).
DATABASE_URL=postgres://user:password@localhost:5432/gestione_docenti

# Optional, default 60. Positive integer, seconds. Solver time limit per generation job (the solve worker).
SOLVER_TIMEOUT_SECONDS=60

# Optional, default 10. Positive integer, seconds, below SOLVER_TIMEOUT_SECONDS. Time budget to explain why an infeasible week has no complete timetable (unsat core); past it the generic message is shown.
SOLVER_EXPLAIN_BUDGET_SECONDS=10

# Optional, default 5242880 (5 MiB). Positive integer, bytes. Largest file the setup wizard accepts.
SETUP_MAX_UPLOAD_BYTES=5242880

# Optional, default 72. Positive integer, hours. How long a magic availability link stays valid.
AVAILABILITY_LINK_TTL_HOURS=72

# Optional, default 10. Positive integer. Failed magic-link lookups from one address within the window before HTTP 429.
LINK_LOOKUP_MAX_FAILURES=10

# Optional, default 300. Positive integer, seconds. Window for LINK_LOOKUP_MAX_FAILURES.
LINK_LOOKUP_WINDOW_SECONDS=300

# Optional, default empty. Anthropic API key. Empty or unset turns the AI features off: no AI button appears and nothing is ever sent.
ANTHROPIC_API_KEY=

# Optional, default claude-haiku-4-5. Anthropic model used for the AI features; the smallest one that passes the tests.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional, default 60. Positive integer, seconds. Time limit for one Anthropic call.
ANTHROPIC_TIMEOUT_SECONDS=60

# Required when DEBUG is false, optional otherwise. Public host name only (no scheme, no path). Used for CSRF_TRUSTED_ORIGINS (https://DOMAIN) and by the Caddy proxy in the production stack.
DOMAIN=localhost
