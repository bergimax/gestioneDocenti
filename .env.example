# Copy to .env (git-ignored) and run: uv run --env-file .env manage.py runserver

# Required. Django secret key. No default. Generate a long random string.
SECRET_KEY=change-me

# Optional, default false. Accepts true, false, 1, 0 (case-insensitive).
DEBUG=false

# Required when DEBUG is false, optional otherwise. Comma-separated host names.
ALLOWED_HOSTS=localhost,127.0.0.1

# Required. PostgreSQL URL; URL-encode special characters in the password (@ is %40).
DATABASE_URL=postgres://user:password@localhost:5432/gestione_docenti

# Optional, default 60. Positive integer, seconds. Solver time limit per generation job (the solve worker).
SOLVER_TIMEOUT_SECONDS=60

# Optional, default 10. Positive integer, seconds, below SOLVER_TIMEOUT_SECONDS. Time budget to explain why an infeasible week has no complete timetable (unsat core); past it the generic message is shown.
SOLVER_EXPLAIN_BUDGET_SECONDS=10

# Optional, default 120. Positive integer, seconds. A job RUNNING longer than SOLVER_TIMEOUT_SECONDS plus this margin is considered dead (worker killed) and marked failed.
# SOLVER_STALE_MARGIN_SECONDS=120

# Optional, default 5242880 (5 MiB). Positive integer, bytes. Largest file the setup wizard accepts.
SETUP_MAX_UPLOAD_BYTES=5242880

# Optional, default 72. Positive integer, hours. Parked setup files not touched for longer than this are deleted by manage.py purge_parked_uploads.
SETUP_UPLOAD_MAX_AGE_HOURS=72

# Optional, default 72. Positive integer, hours. How long a magic availability link stays valid.
AVAILABILITY_LINK_TTL_HOURS=72

# Optional, default 30. Positive integer, days. Expired or revoked availability links older than this are deleted by manage.py purge_availability_links.
AVAILABILITY_LINK_PURGE_DAYS=30

# Optional, default 10. Positive integer. Failed magic-link lookups from one address within the window before HTTP 429.
LINK_LOOKUP_MAX_FAILURES=10

# Optional, default 300. Positive integer, seconds. Window for LINK_LOOKUP_MAX_FAILURES.
LINK_LOOKUP_WINDOW_SECONDS=300

# Optional, default 30. Positive integer. Failed calendar-feed token lookups from one address within the window before HTTP 429.
FEED_LOOKUP_MAX_FAILURES=30

# Optional, default 300. Positive integer, seconds. Window for FEED_LOOKUP_MAX_FAILURES, also sent as Retry-After.
FEED_LOOKUP_WINDOW_SECONDS=300

# Optional, default false. true or 1 turns on the public read-only page of the approved week of a class (/orario/<token>/, class feed token, no teacher names). Leave off unless failed token lookups are rate limited (FEED_LOOKUP_*) and the real client address reaches the app (see #65).
PUBLIC_WEEK_PAGE_ENABLED=false

# Optional, default 5. Positive integer. Failed logins for one email within the window before the login is refused with HTTP 429.
LOGIN_MAX_FAILURES=5

# Optional, default 900. Positive integer, seconds. Window for the login limits, also sent as Retry-After.
LOGIN_WINDOW_SECONDS=900

# Optional, default 20. Positive integer. Failed logins from one client address (any email) within the window before HTTP 429.
LOGIN_ADDRESS_MAX_FAILURES=20

# Optional, default empty. Anthropic API key. Empty or unset turns the AI features off: no AI button appears and nothing is ever sent.
ANTHROPIC_API_KEY=

# Optional, default claude-haiku-4-5. Anthropic model used for the AI features; the smallest one that passes the tests.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional, default 60. Positive integer, seconds. Time limit for one Anthropic call.
ANTHROPIC_TIMEOUT_SECONDS=60

# Required when DEBUG is false, optional otherwise. Public host name only (no scheme, no path). Used for CSRF_TRUSTED_ORIGINS (https://DOMAIN) and by the Caddy proxy in the production stack.
DOMAIN=localhost

# Optional, default ./backups (under the repository, git-ignored). Directory where deploy/backup.sh writes its dumps.
BACKUP_DIR=./backups

# Optional, default 14. Positive integer. How many of the newest dumps deploy/backup.sh keeps; older ones are deleted.
BACKUP_KEEP=14

# Optional, default empty. rclone destination for the weekly off-site copy, e.g. oracle:bucket/path (the bucket must be private). Empty turns the off-site copy off.
OFFSITE_RCLONE_REMOTE=

# Optional, default 30. Positive integer, hours. A backup older than this is reported STALE by deploy/backup-status.sh and on the overview page.
# BACKUP_STALE_HOURS=30

# Optional, default empty. Path of the deploy/backup.sh marker file (last-success) as the web process sees it. Empty shows "Backup non verificabile" to admins.
# BACKUP_MARKER_FILE=./backups/last-success

# Optional, default 192. Positive integer, hours. The last off-site copy (marker last-offsite-success, next to last-success) older than this is reported STALE by deploy/backup-status.sh and on the overview page. Only checked when OFFSITE_RCLONE_REMOTE is set.
# OFFSITE_STALE_HOURS=192

# Optional, default empty. Path of an rclone config file on the host. Alternatively give the credentials as RCLONE_CONFIG_<REMOTE>_* variables in the same env file.
OFFSITE_RCLONE_CONFIG=

# Optional, default empty. PostgreSQL URL of the old (FastAPI) database for manage.py import_legacy; --source overrides it. Opened read-only, never printed.
# IMPORT_SOURCE_URL=postgres://user:password@localhost:5432/old_database

# Optional, default 0. Non-negative integer. Number of reverse proxies in front of Django. 0 ignores X-Forwarded-For (use it without a proxy); 1 trusts the address Caddy puts in it, which the login throttle and the link lookup limiter count.
TRUSTED_PROXY_COUNT=0

# Optional, default off. Non-negative integer, seconds. Blank or 0 sends no Strict-Transport-Security header.
SECURE_HSTS_SECONDS=

# Memory limits of the production stack (docker-compose.yml). Read by Compose only, not by Django.
# A reservation must not exceed its limit, or Docker refuses to start.

# Optional, default 256m. Maximum memory of postgres, an integer followed by b, k, m or g.
# POSTGRES_MEM_LIMIT=256m

# Optional, default 128m. Soft reservation memory of postgres, an integer followed by b, k, m or g.
# POSTGRES_MEM_RESERVATION=128m

# Optional, default 256m. Maximum memory of web, an integer followed by b, k, m or g.
# WEB_MEM_LIMIT=256m

# Optional, default 160m. Soft reservation memory of web, an integer followed by b, k, m or g.
# WEB_MEM_RESERVATION=160m

# Optional, default 448m. Maximum memory of worker, an integer followed by b, k, m or g.
# WORKER_MEM_LIMIT=448m

# Optional, default 256m. Soft reservation memory of worker, an integer followed by b, k, m or g.
# WORKER_MEM_RESERVATION=256m

# Optional, default 64m. Maximum memory of caddy, an integer followed by b, k, m or g.
# CADDY_MEM_LIMIT=64m

# Optional, default 32m. Soft reservation memory of caddy, an integer followed by b, k, m or g.
# CADDY_MEM_RESERVATION=32m

# Optional, default empty. OTLP/HTTP endpoint of the telemetry collector, e.g. http://localhost:4318. Empty turns traces, metrics and OTLP logs off (JSON logs to stdout stay on). The production overlay deploy/observability/otel.yml sets it for web and worker.
# OTEL_EXPORTER_OTLP_ENDPOINT=
